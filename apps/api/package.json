    "test:drawing": "node --test test/drawing.service.test.mjs",
    "test:guessing": "node --test test/guessing.test.mjs",
    "test:lifecycle": "node --test test/game-lifecycle.test.mjs",
    "test:security": "node --test test/security.test.mjs"
  },
  "dependencies": {
    "@draw-and-guess/shared": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/platform-socket.io": "12.6.0",
    "@nestjs/websockets": "12.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@types/node": "^24",
    "typescript": "6.0.3"
